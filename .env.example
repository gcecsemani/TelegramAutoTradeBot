# Copy to .env on the server. Do not commit .env.

# Market-data login only. Orders are sent from accounts linked in the portal.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_USER_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_UPDATE_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO
KITE_RPS=2.5

# Real orders. Leave off until a portal account is on paper and looks right.
LIVE_TRADING=0

# Portal. 127.0.0.1 is only reachable through an SSH tunnel.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
PORTAL_HTTPS=0
# Required for anyone after the first user. Leave empty to keep registration closed.
PORTAL_INVITE_CODE=
