# Copy to .env on the server. Do not commit .env.

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_USER_ID=

TELEGRAM_BOT_TOKEN=
# Signal group: calls are read here. Update group: the bot posts here.
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_UPDATE_CHAT_ID=
# Optional. Comma-separated Telegram user ids. Empty = every member.
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO
KITE_RPS=2.5
